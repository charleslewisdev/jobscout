# ─── LLM Integration ───
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Database ───
DATABASE_URL=./data/jobscout.db

# ─── External Services ───
FLARESOLVERR_URL=http://flaresolverr:8191/v1
CHROME_CDP_URL=ws://chrome-cdp:3000

# ─── Pipeline Configuration ───
# Cron schedule (default: every 6 hours)
SCAN_CRON=0 */6 * * *
# Minimum confidence score to store a match (default: 25)
MIN_CONFIDENCE_THRESHOLD=25
# Enable dry run mode (no LLM calls, no DB writes)
DRY_RUN=false

# ─── API Keys for Data Sources ───
# Adzuna (register at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs (register at developer.usajobs.gov)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Careerjet (register at www.careerjet.com/partners)
CAREERJET_AFFID=

# ─── Authentication ───
# Secret key for signing JWT tokens (auto-generated if empty)
JWT_SECRET=
# Initial admin account (created on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Logging ───
LOG_LEVEL=info

# ─── Server ───
PORT=3080
